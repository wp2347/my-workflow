generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [pgvector(map: "vector", schema: "public")]
}

model Workflow {
  id           String    @id @default(cuid())
  name         String
  description  String?
  config       Json      @default("{}")
  enabled      Boolean   @default(true) @map("enabled")
  schedule     String?   @map("schedule")
  webhookId    String?   @unique @map("webhook_id")
  webhookSecret String?  @map("webhook_secret")
  notifyChatId String?   @map("notify_chat_id")
  lastRunAt    DateTime? @map("last_run_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  nodes      WorkflowNode[]
  edges      WorkflowEdge[]
  executions Execution[]
  cronJobs   WorkflowCronJob[]

  @@map("workflows")
}

model WorkflowNode {
  id         String   @id @default(cuid())
  workflowId String   @map("workflow_id")
  type       String
  positionX  Float    @default(0) @map("position_x")
  positionY  Float    @default(0) @map("position_y")
  data       Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@map("workflow_nodes")
}

model WorkflowEdge {
  id           String  @id @default(cuid())
  workflowId   String  @map("workflow_id")
  source       String
  target       String
  sourceHandle String? @map("source_handle")
  targetHandle String? @map("target_handle")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@map("workflow_edges")
}

model Execution {
  id         String    @id @default(cuid())
  workflowId String    @map("workflow_id")
  status     String    @default("pending")
  input      Json      @default("{}")
  output     Json?
  logs       Json      @default("[]")
  error      String?
  startedAt  DateTime? @map("started_at")
  finishedAt DateTime? @map("finished_at")
  durationMs Int?      @map("duration_ms")
  createdAt  DateTime  @default(now()) @map("created_at")

  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@map("executions")
}

model Credential {
  id        String   @id @default(cuid())
  name      String
  type      String   @default("api_key")
  value     String
  scope     String   @default("global")
  workflowId String? @map("workflow_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("credentials")
}

model Document {
  id        String   @id @default(cuid())
  name      String
  content   String   @db.Text
  type      String   @default("txt")
  chunkSize Int      @default(500) @map("chunk_size")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  chunks DocumentChunk[]

  @@map("documents")
}

model DocumentChunk {
  id         String   @id @default(cuid())
  documentId String   @map("document_id")
  content    String   @db.Text
  chunkIndex Int      @map("chunk_index")
  embedding  Unsupported("vector(1536)")?
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at")

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@map("document_chunks")
}

model WorkflowCronJob {
  id         String    @id @default(cuid())
  workflowId String    @map("workflow_id")
  name       String
  cronExpr   String    @map("cron_expr")
  timezone   String    @default("Asia/Shanghai")
  enabled    Boolean   @default(true) @map("enabled")
  input      Json      @default("{}")
  lastRunAt  DateTime? @map("last_run_at")
  nextRunAt  DateTime? @map("next_run_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@unique([workflowId, name])
  @@map("workflow_cron_jobs")
}
