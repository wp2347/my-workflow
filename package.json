{
  "name": "my-workflow",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "lsof -ti:3000 > /dev/null 2>&1 && echo '❌ 端口3000被占用，请先运行: kill $(lsof -ti:3000)' && exit 1 || next dev --webpack",
    "dev:webpack": "next dev --webpack",
    "dev:feishu": "kill $(lsof -ti:3000) 2>/dev/null; pkill -9 -f ngrok 2>/dev/null; pkill -9 -f 'cron-worker-start' 2>/dev/null; sleep 1; npx tsx src/lib/cron-worker-start.ts & ngrok http 3000 --log=stdout & NGROK_PID=$!; sleep 6; echo ''; echo '============================================'; curl -s http://127.0.0.1:4040/api/tunnels 2>/dev/null | python3 -c \"import sys,json; u=json.load(sys.stdin)['tunnels'][0]['public_url']; print(f'  ngrok: {u}'); print(f'  回调:   {u}/api/feishu/callback'); print('  (去飞书后台确认这个地址)')\" 2>/dev/null || echo '  ngrok starting...'; echo '============================================'; echo ''; trap 'kill $NGROK_PID 2>/dev/null' EXIT; next dev --webpack",
    "worker": "npx tsx src/lib/cron-worker-start.ts",
    "start": "npm run dev:feishu",
    "build": "next build --webpack",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.81",
    "@ai-sdk/deepseek": "^3.0.0",
    "@ai-sdk/google": "^3.0.0",
    "@ai-sdk/groq": "^3.0.0",
    "@ai-sdk/mcp": "^2.0.4",
    "@ai-sdk/mistral": "^3.0.0",
    "@ai-sdk/openai": "^3.0.66",
    "@ai-sdk/xai": "^3.0.0",
    "@base-ui/react": "^1.5.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@xyflow/react": "^12.10.2",
    "ai": "^6.0.193",
    "bullmq": "^5.77.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cron-parser": "^5.4.0",
    "docx": "^9.7.1",
    "dotenv": "^16.5.0",
    "exceljs": "^4.4.0",
    "ioredis": "^5.11.0",
    "jszip": "^3.10.1",
    "lucide-react": "^1.17.0",
    "marked": "^18.0.9",
    "next": "16.2.6",
    "pdfmake": "^0.3.11",
    "pptxgenjs": "^4.0.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.8.3",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.25.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/ioredis": "^4.28.10",
    "@types/jszip": "^3.4.0",
    "@types/node": "^20",
    "@types/pdfmake": "^0.3.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "happy-dom": "^20.10.6",
    "prisma": "^7.8.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.9"
  }
}
